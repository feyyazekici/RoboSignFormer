<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robosignformer</name>
  <version>1.0.0</version>
  <description>RoboSignFormer: Ultra-Lightweight 4-Stream Skeletal Conv-Transformer for Turkish Sign Language Recognition (PC &amp; ROS2 Edge)</description>
  <maintainer email="ekici.abdullahfeyyaz@gmail.com">Abdullah Feyyaz Ekici</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>ament_index_python</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
